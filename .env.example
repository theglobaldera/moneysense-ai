# Required for the "Ask MoneySense" AI assistant (app/api/ask/route.ts).
# Free — get a key at https://aistudio.google.com/apikey (no credit card needed).
GEMINI_API_KEY=

# Optional: override the model used for Ask MoneySense.
# Defaults to Gemini's free-tier model (1,500 requests/day, no cost).
GEMINI_MODEL=gemini-3.6-flash

# Optional: your deployed site's full URL (e.g. https://moneysense-ai.vercel.app).
# Used for social-preview links, robots.txt, and sitemap.xml. Defaults to
# localhost, which is fine for local development.
NEXT_PUBLIC_SITE_URL=
